# =============================================================================
# SkyBus — Crypto News & Trading Intelligence Platform
# Copy to .env and fill in values. All secrets stay out of git.
# =============================================================================

# --- Backend core ---
BACKEND_PORT=8000
# Comma-separated CORS origins for the FastAPI app
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=skybus
POSTGRES_PASSWORD=skybus_dev_password
POSTGRES_DB=skybus
# Used by the backend (inside docker network use db:5432)
DATABASE_URL=postgresql+asyncpg://skybus:skybus_dev_password@localhost:5432/skybus

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CoinGecko (public demo key optional; without a key free rate limits apply) ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- News providers (all optional; platform stays functional without them) ---
# https://newsdata.io/  (free tier available)
NEWSDATA_API_KEY=
# https://gnews.io/  (free tier available)
GNEWS_API_KEY=

# --- CoinGlass (OPTIONAL premium; without it the app uses a labelled estimation model) ---
COINGLASS_API_KEY=

# --- Agent API (GT Quant and other machine consumers) ---
# Comma-separated name:key pairs. Keys grant read + stream scopes.
# Generate with e.g.: openssl rand -hex 24
AGENT_API_KEYS=
AGENT_RATE_LIMIT_PER_MIN=120
# Server-side key used by the Next.js frontend to show the Agent Events feed
# (must match one of the keys in AGENT_API_KEYS). Never exposed to the browser.
AGENT_API_KEY=

# --- Frontend ---
FRONTEND_PORT=3000
# Where the Next.js server proxies /api requests (inside docker use http://backend:8000)
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Ingestion tuning ---
# Symbols tracked by the realtime Binance/Bybit websocket workers
TRACKED_SYMBOLS=BTC,ETH,SOL,XRP,BNB,DOGE,ADA,TRX,AVAX,LINK
# Poll intervals (seconds)
MARKET_POLL_INTERVAL=60
NEWS_POLL_INTERVAL=300
FEAR_GREED_POLL_INTERVAL=600
